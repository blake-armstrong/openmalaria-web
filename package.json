{
  "name": "openmalaria-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web frontend for the OpenMalaria simulator (openmalaria-wasm)",
  "scripts": {
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "predev": "npm run copy-wasm",
    "dev": "vite",
    "prebuild": "npm run copy-wasm",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "openmalaria-wasm": "file:../openmalaria-fork/js",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
