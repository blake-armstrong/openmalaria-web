{
  "name": "openmalaria-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web frontend for the OpenMalaria simulator (openmalaria-wasm)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:pyodide": "bash scripts/fetch-pyodide-assets.sh"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lint": "^6.9.7",
    "@uiw/react-codemirror": "^4.23.6",
    "openmalaria-wasm": "file:../openmalaria-wasm-port/js",
    "pyodide": "^314.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
